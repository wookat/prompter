{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prompter",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.ts",
  "routes": [{ "pattern": "prompter.zalize.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    // All routes exist as prebuilt static files (see scripts/build-seo.mjs),
    // so unknown paths get a real 404 instead of an SPA soft-404.
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    // Anonymous usage counters (page views / prompter starts). No PII.
    { "binding": "KV", "id": "55d76149296445cebc18a420e6adc200" }
  ],
  "observability": {
    "enabled": true
  }
}
